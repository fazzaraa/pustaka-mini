# Salin file ini menjadi .env lalu isi nilainya:  Copy-Item .env.example .env
# Jangan commit file .env (sudah ada di .gitignore).

# Hasil dari: cd backend; php artisan key:generate --show
APP_KEY=

DB_DATABASE=pustaka
